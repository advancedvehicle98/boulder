BUILD_DIR ?= ./build

SRC_DIR = ./src
INC_DIR = ./include

COMPONENTS = can

CAN_TARGETS = data.o deinit.o init.o

OBJS = \
	init.o main.o parse_args.o \ 
	$(foreach T,$(CAN_TARGETS),can/$(T))

TARGETS = $(foreach O,$(OBJS),$(BUILD_DIR)/$(O))

ALL_DIRS = \
	$(SRC_DIR) \
	$(foreach C,$(COMPONENTS),$(SRC_DIR)/$(C)) \
	./config \
	./config/master \
	./config/slave


# настройки тулчейнв =====================================

TOOLCHAIN ?= $(CONFIG_MASTER_TOOLCHAIN)

# компилятор ---------------------------------------------
CC = $(TOOLCHAIN)-gcc

CFLAGS += -O2

CFLAGS += -I $(INC_DIR)

# линковщик ---------------------------------------------
LD = $(CC)

LDFLAGS = 


PHONY = all
all: build_dir compile link


PHONY += compile
compile: $(TARGETS)

$(BUILD_DIR)/%.o: src/%.c
	$(CC) $(CFLAGS) -c $^ -o $@


PHONY += link
link:
	$(LD) $(TARGETS) -o $(BUILD_DIR)/out/master


PHONY += build_dir
build_dir: $(foreach C,$(COMPONENTS),$(BUILD_DIR)/$(C))
	mkdir -p $(BUILD_DIR)/out

$(BUILD_DIR)/%:
	mkdir -p $@


PHONY += clean
clean: remove_squiggles
	rm -rf $(BUILD_DIR)

PHONY += remove_squiggles
remove_squiggles:
	rm -rf $(foreach D,$(ALL_DIRS),$(D)/*~)


.PHONY: $(PHONY)
